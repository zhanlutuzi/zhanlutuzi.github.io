---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPostPath } from "../lib/blog";
import {
  education,
  experiences,
  personalWorks,
  projects,
  publications,
} from "../data/portfolio";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="回到首页">
      <span>喻承龙</span>
      <small>CHENGLONG YU</small>
    </a>
    <nav aria-label="页内导航">
      <a href="#about">关于</a>
      <a href="#experience">经历</a>
      <a href="#projects">项目</a>
      <a href="#research">研究</a>
      <a href="#notes">写作</a>
    </nav>
    <div class="header-actions">
      <a
        href="https://www.linkedin.com/in/chenglong-yu-432306243"
        target="_blank"
        rel="noreferrer">LinkedIn ↗</a
      >
      <a class="header-link" href="mailto:yuchenglong01@foxmail.com"
        >联系我 ↗</a
      >
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <canvas class="contour-canvas" aria-hidden="true"></canvas>
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>
          GEOGRAPHY · TECHNOLOGY · PEOPLE
        </p>
        <h1 data-reveal>
          沿着好奇心，<br />
          <em>去理解，</em><br />
          也去动手。
        </h1>
        <p class="hero-intro" data-reveal>
          我把自己叫作“杂学家”。地理是观察世界的起点，技术是理解并改变问题的工具，而人始终是我判断一件事是否值得做的尺度。
        </p>
        <div class="hero-actions" data-reveal>
          <a class="button button-dark" href="#projects">看我做过什么</a>
          <a class="button button-ghost" href="#experience">看我的经历</a>
        </div>
      </div>

      <div class="hero-globe">
        <canvas
          class="journey-globe"
          aria-label="武汉、东京、杭州与北京组成的个人经历路径"
        ></canvas>
        <div class="globe-caption" aria-hidden="true">
          <span>PERSONAL JOURNEY</span>
          <strong>武汉 · 东京 · 杭州 · 北京</strong>
        </div>
      </div>

      <a class="scroll-cue" href="#about">
        <span>向下认识我</span>
        <i></i>
      </a>
    </section>

    <section class="manifesto section-shell" id="about">
      <div class="section-index" data-reveal>00 / ABOUT</div>
      <div class="manifesto-grid">
        <h2 data-reveal>站在人文与<br />技术之间。</h2>
        <div class="manifesto-copy" data-reveal>
          <p>
            我本科和硕士都学习地理空间信息工程。地理让我关注人、城市、空间与关系；编程让我能把判断做成工具、系统和可以验证的原型。
          </p>
          <p>
            从 WebGIS、空间分析到 NL2SQL 与 Agent，我既做研究，也写代码、搭服务、做产品。我不想做远离真实人的技术，也不满足于只讨论概念。<strong>好奇心打开问题，人文视角决定方向，技术能力让我把想法真正做出来。</strong>
          </p>
        </div>
      </div>
    </section>

    <section class="experience section-shell" id="experience">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">01 / EXPERIENCE</span>
          <h2>走过的路</h2>
        </div>
        <p>这三段经历里，我做研究、写代码，也和真实用户一起把产品往前推。</p>
      </div>

      <div class="timeline">
        {
          experiences.map((item) => (
            <article class="timeline-item" data-reveal>
              <div class="timeline-meta">
                <time>{item.period}</time>
                <strong class="timeline-place">{item.place}</strong>
                {
                  item.academic && (
                    <div class="timeline-academic">
                      <span>{item.academic.label}</span>
                      <a
                        href={item.academic.institutionHref}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {item.academic.institution} ↗
                      </a>
                      <a
                        href={item.academic.advisorHref}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {item.academic.advisor} ↗
                      </a>
                    </div>
                  )
                }
              </div>
              <div class="timeline-main">
                <h3>{item.organization}</h3>
                <p class="department">{item.department}</p>
                <p class="role">{item.role}</p>
                <p class="timeline-summary">{item.summary}</p>
                <ul>
                  {item.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div class="education-heading" data-reveal>
        <span class="section-index">EDUCATION</span>
        <h3>教育经历</h3>
      </div>
      <div class="education-list">
        {
          education.map((item) => (
            <article class="education-item" data-reveal>
              <div class="education-meta">
                <strong>{item.degree}</strong>
                <time>{item.period}</time>
              </div>
              <div>
                <h4>{item.school}</h4>
                <p class="education-field">{item.field}</p>
                <p class="education-detail">{item.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="projects section-shell" id="projects">
      <div class="section-heading light" data-reveal>
        <div>
          <span class="section-index">02 / SELECTED WORK</span>
          <h2>做过的东西</h2>
        </div>
        <p>三个项目都从地理问题出发：先理解数据，再调用工具，最后走进真实的工作入口。</p>
      </div>

      <div class="project-grid">
        {
          projects.map((project) => (
            <article
              class={`project-card tone-${project.tone}`}
              data-reveal
              data-tilt
            >
              <div class="project-topline">
                <span>{project.index}</span>
                <span>{project.eyebrow}</span>
              </div>
              {
                project.links.find((link) => link.kind === "video") && (
                  <button
                    class="project-preview"
                    type="button"
                    data-video={
                      project.links.find((link) => link.kind === "video")?.href
                    }
                    data-video-title={project.title}
                    aria-label={`观看 ${project.title} 项目演示`}
                  >
                    <img
                      src={project.preview}
                      alt={`${project.title} 演示画面`}
                      loading="lazy"
                    />
                    <span class="preview-action">
                      <b>▶</b>
                      <span>观看演示</span>
                      <small>{project.duration}</small>
                    </span>
                  </button>
                )
              }
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <strong class="project-result">{project.result}</strong>
              <ul class="tag-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.links.some((link) => link.kind !== "video") && (
                <div class="project-links">
                  {project.links
                    .filter((link) => link.kind !== "video")
                    .map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label} ↗
                      </a>
                    ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="personal-work section-shell">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">03 / BUILT FOR MYSELF</span>
          <h2>因为自己需要，<br />所以动手做了</h2>
        </div>
        <p>一些工作之外的工具、方法和长期维护。</p>
      </div>
      <div class="work-list">
        {
          personalWorks.map((work, index) => (
            <a
              class="work-row"
              href={work.href}
              target="_blank"
              rel="noreferrer"
              data-reveal
            >
              <span class="work-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <small>{work.meta}</small>
                <h3>{work.title}</h3>
              </div>
              <p>{work.description}</p>
              <span class="work-arrow">{work.label} ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="research section-shell" id="research">
      <div class="research-intro" data-reveal>
        <span class="section-index">04 / RESEARCH</span>
        <h2>研究，是另一种<br />理解世界的方式。</h2>
        <p>
          我的研究从地理数据库的人机交互，延伸到多模态土地利用识别、地理表征学习与全球风险分析。
        </p>
        <a
          href="https://www.researchgate.net/profile/Chenglong-Yu-10"
          target="_blank"
          rel="noreferrer">ResearchGate ↗</a
        >
      </div>

      <div class="publication-list">
        {
          publications.map((publication) => (
            <a
              href={publication.href}
              target="_blank"
              rel="noreferrer"
              class="publication"
              data-reveal
            >
              <div>
                <span>{publication.year}</span>
                <span>{publication.role}</span>
              </div>
              <h3>{publication.title}</h3>
              <p>{publication.venue}</p>
              <i>↗</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="notes section-shell" id="notes">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">05 / NOTES</span>
          <h2>最近在想什么</h2>
        </div>
        <p>记录理解发生的过程，而不只保存最后的答案。</p>
      </div>

      <div class="notes-grid">
        {
          posts.map((post, index) => (
            <a class="note-card" href={getPostPath(post)} data-reveal>
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <time>{formatDate(post.data.date)}</time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <span class="note-more">阅读全文 ↗</span>
            </a>
          ))
        }
      </div>
      <a class="all-notes" href="/blog/">查看全部文章 <span>→</span></a>
    </section>

    <section class="closing section-shell" id="contact">
      <p data-reveal>
        好奇心不会直接给出答案，<br />但它会不断打开新的入口。
      </p>
      <div data-reveal>
        <span>如果你也在思考 AI、地理、工具，或者某个还没有名字的问题——</span>
        <div class="contact-links">
          <a href="mailto:yuchenglong01@foxmail.com"
            >yuchenglong01@foxmail.com ↗</a
          >
          <a
            href="https://www.linkedin.com/in/chenglong-yu-432306243"
            target="_blank"
            rel="noreferrer">LinkedIn ↗</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div>
      <strong>喻承龙</strong>
      <span>Chenglong Yu</span>
    </div>
    <p>沿着好奇心，去理解，也去动手。</p>
    <div class="footer-links">
      <a href="https://github.com/zhanlutuzi" target="_blank" rel="noreferrer"
        >GitHub ↗</a
      >
      <a
        href="https://www.researchgate.net/profile/Chenglong-Yu-10"
        target="_blank"
        rel="noreferrer">ResearchGate ↗</a
      >
      <a
        href="https://www.linkedin.com/in/chenglong-yu-432306243"
        target="_blank"
        rel="noreferrer">LinkedIn ↗</a
      >
      <a href="/blog/">Blog ↗</a>
    </div>
  </footer>

  <dialog class="video-dialog">
    <form method="dialog">
      <div>
        <span class="video-dialog-label">PROJECT DEMO</span>
        <strong data-dialog-title>项目演示</strong>
      </div>
      <button aria-label="关闭视频">关闭 ×</button>
    </form>
    <video controls playsinline preload="metadata"></video>
  </dialog>

  <script>
    const canvas = document.querySelector<HTMLCanvasElement>(".contour-canvas");
    const context = canvas?.getContext("2d");
    let pointerX = 0.64;
    let pointerY = 0.42;
    let frame = 0;

    function resizeCanvas() {
      if (!canvas) return;
      const ratio = Math.min(devicePixelRatio, 2);
      canvas.width = canvas.clientWidth * ratio;
      canvas.height = canvas.clientHeight * ratio;
    }

    function drawContours() {
      if (!canvas || !context) return;
      const ratio = Math.min(devicePixelRatio, 2);
      const width = canvas.width / ratio;
      const height = canvas.height / ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const t = reduced ? 0 : frame * 0.004;
      const focusX = width * pointerX;
      const focusY = height * pointerY;

      for (let line = -5; line < 18; line += 1) {
        context.beginPath();
        for (let x = -40; x <= width + 40; x += 8) {
          const distance = Math.hypot(x - focusX, line * 52 - focusY);
          const wave =
            Math.sin(x * 0.007 + line * 0.8 + t) * 22 +
            Math.cos(x * 0.003 - line + t * 0.6) * 13 +
            Math.sin(distance * 0.014 - t) * 18;
          const y = line * 52 + wave + height * 0.08;
          if (x === -40) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.strokeStyle =
          line % 4 === 0 ? "rgba(19, 32, 24, .35)" : "rgba(19, 32, 24, .14)";
        context.lineWidth = line % 4 === 0 ? 1.2 : 0.8;
        context.stroke();
      }

      frame += 1;
      requestAnimationFrame(drawContours);
    }

    addEventListener("resize", resizeCanvas);
    addEventListener(
      "pointermove",
      (event) => {
        pointerX = event.clientX / innerWidth;
        pointerY = event.clientY / innerHeight;
      },
      { passive: true },
    );
    resizeCanvas();
    drawContours();

    const globeCanvas =
      document.querySelector<HTMLCanvasElement>(".journey-globe");
    const globeContext = globeCanvas?.getContext("2d");
    const journeyCities = [
      {
        name: "武汉",
        lat: 30.59,
        lon: 114.3,
        color: "#3755ff",
        dx: -45,
        dy: 23,
      },
      {
        name: "东京",
        lat: 35.68,
        lon: 139.76,
        color: "#ff7b32",
        dx: 13,
        dy: -13,
      },
      {
        name: "杭州",
        lat: 30.27,
        lon: 120.15,
        color: "#142019",
        dx: 10,
        dy: 30,
      },
      {
        name: "北京",
        lat: 39.9,
        lon: 116.41,
        color: "#142019",
        dx: -44,
        dy: -14,
      },
    ];

    function resizeGlobe() {
      if (!globeCanvas) return;
      const ratio = Math.min(devicePixelRatio, 2);
      globeCanvas.width = globeCanvas.clientWidth * ratio;
      globeCanvas.height = globeCanvas.clientHeight * ratio;
    }

    function projectGlobePoint(
      lat: number,
      lon: number,
      centerLon: number,
      tilt: number,
      centerX: number,
      centerY: number,
      radius: number,
    ) {
      const phi = (lat * Math.PI) / 180;
      const lambda = (lon * Math.PI) / 180 - centerLon;
      const x = Math.cos(phi) * Math.sin(lambda);
      const originalY = -Math.sin(phi);
      const originalZ = Math.cos(phi) * Math.cos(lambda);
      const y =
        originalY * Math.cos(tilt) - originalZ * Math.sin(tilt);
      const z =
        originalY * Math.sin(tilt) + originalZ * Math.cos(tilt);
      return {
        x: centerX + x * radius,
        y: centerY + y * radius,
        visible: z > -0.01,
      };
    }

    function drawProjectedLine(
      coordinates: { lat: number; lon: number }[],
      centerLon: number,
      tilt: number,
      centerX: number,
      centerY: number,
      radius: number,
    ) {
      if (!globeContext) return;
      let drawing = false;
      globeContext.beginPath();
      coordinates.forEach((coordinate) => {
        const point = projectGlobePoint(
          coordinate.lat,
          coordinate.lon,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
        if (!point.visible) {
          drawing = false;
          return;
        }
        if (!drawing) {
          globeContext.moveTo(point.x, point.y);
          drawing = true;
        } else {
          globeContext.lineTo(point.x, point.y);
        }
      });
      globeContext.stroke();
    }

    function drawGlobe() {
      if (!globeCanvas || !globeContext) return;
      const ratio = Math.min(devicePixelRatio, 2);
      const width = globeCanvas.width / ratio;
      const height = globeCanvas.height / ratio;
      const centerX = width / 2;
      const centerY = height / 2 - 8;
      const radius = Math.min(width, height) * 0.39;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const centerLon =
        (124 * Math.PI) / 180 +
        (pointerX - 0.5) * 0.16 +
        (reduced ? 0 : Math.sin(frame * 0.003) * 0.025);
      const tilt = -0.12 + (pointerY - 0.5) * 0.1;

      globeContext.setTransform(ratio, 0, 0, ratio, 0, 0);
      globeContext.clearRect(0, 0, width, height);

      const fill = globeContext.createRadialGradient(
        centerX - radius * 0.28,
        centerY - radius * 0.35,
        radius * 0.08,
        centerX,
        centerY,
        radius,
      );
      fill.addColorStop(0, "rgba(255, 254, 248, 0.78)");
      fill.addColorStop(0.72, "rgba(204, 255, 77, 0.16)");
      fill.addColorStop(1, "rgba(55, 85, 255, 0.08)");
      globeContext.beginPath();
      globeContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
      globeContext.fillStyle = fill;
      globeContext.fill();
      globeContext.strokeStyle = "rgba(20, 32, 25, 0.62)";
      globeContext.lineWidth = 1.4;
      globeContext.stroke();

      globeContext.save();
      globeContext.beginPath();
      globeContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
      globeContext.clip();
      globeContext.strokeStyle = "rgba(20, 32, 25, 0.18)";
      globeContext.lineWidth = 0.8;

      for (let lat = -60; lat <= 60; lat += 20) {
        const coordinates = [];
        for (let lon = -180; lon <= 180; lon += 3) {
          coordinates.push({ lat, lon });
        }
        drawProjectedLine(
          coordinates,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      }

      for (let lon = -180; lon < 180; lon += 20) {
        const coordinates = [];
        for (let lat = -90; lat <= 90; lat += 3) {
          coordinates.push({ lat, lon });
        }
        drawProjectedLine(
          coordinates,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      }

      globeContext.strokeStyle = "rgba(55, 85, 255, 0.72)";
      globeContext.lineWidth = 1.8;
      globeContext.setLineDash([4, 5]);
      for (let index = 0; index < journeyCities.length - 1; index += 1) {
        const start = journeyCities[index];
        const end = journeyCities[index + 1];
        const coordinates = [];
        for (let step = 0; step <= 28; step += 1) {
          const progress = step / 28;
          coordinates.push({
            lat:
              start.lat +
              (end.lat - start.lat) * progress +
              Math.sin(progress * Math.PI) * 2.5,
            lon: start.lon + (end.lon - start.lon) * progress,
          });
        }
        drawProjectedLine(
          coordinates,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      }
      globeContext.setLineDash([]);
      globeContext.restore();

      journeyCities.forEach((city, index) => {
        const point = projectGlobePoint(
          city.lat,
          city.lon,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
        if (!point.visible) return;
        const pulse =
          reduced ? 0 : Math.sin(frame * 0.045 + index * 1.4) * 1.5;
        globeContext.beginPath();
        globeContext.arc(point.x, point.y, 8 + pulse, 0, Math.PI * 2);
        globeContext.fillStyle = `${city.color}22`;
        globeContext.fill();
        globeContext.beginPath();
        globeContext.arc(point.x, point.y, 4.2, 0, Math.PI * 2);
        globeContext.fillStyle = city.color;
        globeContext.fill();
        globeContext.font =
          '600 13px "PingFang SC", "Microsoft YaHei", sans-serif';
        globeContext.fillStyle = "#142019";
        globeContext.fillText(
          city.name,
          point.x + city.dx,
          point.y + city.dy,
        );
      });

      requestAnimationFrame(drawGlobe);
    }

    addEventListener("resize", resizeGlobe);
    resizeGlobe();
    drawGlobe();

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty("--rx", `${-y * 3.5}deg`);
        card.style.setProperty("--ry", `${x * 5}deg`);
      });
      card.addEventListener("pointerleave", () => {
        card.style.setProperty("--rx", "0deg");
        card.style.setProperty("--ry", "0deg");
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>(".video-dialog");
    const player = dialog?.querySelector("video");
    const dialogTitle = dialog?.querySelector<HTMLElement>(
      "[data-dialog-title]",
    );

    document.querySelectorAll<HTMLButtonElement>("[data-video]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!dialog || !player) return;
        player.src = button.dataset.video || "";
        if (dialogTitle) {
          dialogTitle.textContent = button.dataset.videoTitle || "项目演示";
        }
        dialog.showModal();
      });
    });

    dialog?.addEventListener("close", () => {
      if (!player) return;
      player.pause();
      player.removeAttribute("src");
      player.load();
    });
  </script>
</BaseLayout>
