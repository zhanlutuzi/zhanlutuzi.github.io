---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPostPath } from "../lib/blog";
import {
  experiences,
  personalWorks,
  projects,
  publications,
} from "../data/portfolio";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="回到首页">
      <span>喻承龙</span>
      <small>CHENGLONG YU</small>
    </a>
    <nav aria-label="页内导航">
      <a href="#about">关于</a>
      <a href="#experience">经历</a>
      <a href="#projects">项目</a>
      <a href="#research">研究</a>
      <a href="#notes">写作</a>
    </nav>
    <a class="header-link" href="mailto:yuchenglong01@foxmail.com">联系我 ↗</a>
  </header>

  <main id="top">
    <section class="hero">
      <canvas class="contour-canvas" aria-hidden="true"></canvas>
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>
          GEOGRAPHY · AI · THINGS I AM CURIOUS ABOUT
        </p>
        <h1 data-reveal>
          沿着好奇心，<br />
          <em>去理解，</em><br />
          也去动手。
        </h1>
        <p class="hero-intro" data-reveal>
          我热爱地理，也对技术、人和世界如何运作保持兴趣。我把自己叫作“杂学家”——还谈不上博学，只是愿意走进陌生领域，并把一些想法真正做出来。
        </p>
        <div class="hero-actions" data-reveal>
          <a class="button button-dark" href="#projects">看看我做过的东西</a>
          <a class="button button-ghost" href="/blog/">读一些思考</a>
        </div>
      </div>

      <div class="hero-orbit" aria-hidden="true">
        <div class="orbit-ring orbit-ring-one"></div>
        <div class="orbit-ring orbit-ring-two"></div>
        <span class="orbit-label label-a">地理</span>
        <span class="orbit-label label-b">Agent</span>
        <span class="orbit-label label-c">系统</span>
        <span class="orbit-label label-d">写作</span>
        <span class="orbit-core">?</span>
      </div>

      <div class="hero-coordinates">
        <span>30.59° N</span>
        <span>114.30° E</span>
        <span>WUHAN · TOKYO · BEIJING</span>
      </div>
      <a class="scroll-cue" href="#about">
        <span>向下认识我</span>
        <i></i>
      </a>
    </section>

    <section class="manifesto section-shell" id="about">
      <div class="section-index" data-reveal>00 / ABOUT</div>
      <div class="manifesto-grid">
        <h2 data-reveal>我的路径<br />不算笔直。</h2>
        <div class="manifesto-copy" data-reveal>
          <p>
            从 WebGIS 和空间分析，到 NL2SQL、Agent、教育应用和个人工具，我总会沿着一个问题走进另一个领域。
          </p>
          <p>
            地理训练让我习惯从空间、尺度与关系看问题；研发经历让我习惯把问题拆开，再把它们接回真实系统。共同点不是某个框架，而是我总想知道：<strong>它为什么这样工作，还能不能做得更好？</strong>
          </p>
        </div>
      </div>
      <div class="topic-river" aria-label="关注领域">
        <div>
          <span>地理空间智能</span><i>·</i><span>Agent</span><i>·</i><span
            >大模型应用</span
          ><i>·</i><span>软件与工具</span><i>·</i><span>学习方法</span
          ><i>·</i><span>城市与人</span><i>·</i>
        </div>
        <div aria-hidden="true">
          <span>地理空间智能</span><i>·</i><span>Agent</span><i>·</i><span
            >大模型应用</span
          ><i>·</i><span>软件与工具</span><i>·</i><span>学习方法</span
          ><i>·</i><span>城市与人</span><i>·</i>
        </div>
      </div>
    </section>

    <section class="experience section-shell" id="experience">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">01 / EXPERIENCE</span>
          <h2>走过的路</h2>
        </div>
        <p>不是岗位列表，而是问题如何一步步发生变化。</p>
      </div>

      <div class="timeline">
        {
          experiences.map((item, index) => (
            <article class="timeline-item" data-reveal>
              <div class="timeline-marker">
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="timeline-meta">
                <time>{item.period}</time>
                <span>{item.place}</span>
              </div>
              <div class="timeline-main">
                <h3>{item.organization}</h3>
                <p class="role">{item.role}</p>
                <p class="timeline-summary">{item.summary}</p>
                <ul>
                  {item.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div class="education-strip" data-reveal>
        <span>EDUCATION</span>
        <div>
          <strong>中国地质大学（武汉） × 东京大学</strong>
          <p>
            地理空间信息工程硕士在读 · 专业前 5% · 东京大学空间情报科学研究中心联合培养
          </p>
        </div>
        <time>2024 — 2027</time>
      </div>
    </section>

    <section class="projects section-shell" id="projects">
      <div class="section-heading light" data-reveal>
        <div>
          <span class="section-index">02 / SELECTED WORK</span>
          <h2>做过的东西</h2>
        </div>
        <p>项目不是技术名词的集合，而是一个问题如何被理解、验证并真正做出来。</p>
      </div>

      <div class="project-grid">
        {
          projects.map((project) => (
            <article
              class={`project-card tone-${project.tone}`}
              data-reveal
              data-tilt
            >
              <div class="project-topline">
                <span>{project.index}</span>
                <span>{project.eyebrow}</span>
              </div>
              <div class="project-visual" aria-hidden="true">
                <span>{project.title.slice(0, 2)}</span>
                <i></i><i></i><i></i>
              </div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <strong class="project-result">{project.result}</strong>
              <ul class="tag-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.links.length > 0 && (
                <div class="project-links">
                  {project.links.map((link) =>
                    link.kind === "video" ? (
                      <button
                        type="button"
                        data-video={link.href}
                        data-video-title={project.title}
                      >
                        {link.label} <span>▶</span>
                      </button>
                    ) : (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label} ↗
                      </a>
                    ),
                  )}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="personal-work section-shell">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">03 / BUILT FOR MYSELF</span>
          <h2>因为自己需要，<br />所以动手做了</h2>
        </div>
        <p>一些工作之外的工具、方法和长期维护。</p>
      </div>
      <div class="work-list">
        {
          personalWorks.map((work, index) => (
            <a
              class="work-row"
              href={work.href}
              target="_blank"
              rel="noreferrer"
              data-reveal
            >
              <span class="work-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <small>{work.meta}</small>
                <h3>{work.title}</h3>
              </div>
              <p>{work.description}</p>
              <span class="work-arrow">{work.label} ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="research section-shell" id="research">
      <div class="research-intro" data-reveal>
        <span class="section-index">04 / RESEARCH</span>
        <h2>研究，是另一种<br />理解世界的方式。</h2>
        <p>
          我的研究从地理数据库的人机交互，延伸到多模态土地利用识别、地理表征学习与全球风险分析。
        </p>
        <a
          href="https://www.researchgate.net/profile/Chenglong-Yu-10"
          target="_blank"
          rel="noreferrer">ResearchGate ↗</a
        >
      </div>

      <div class="publication-list">
        {
          publications.map((publication) => (
            <a
              href={publication.href}
              target="_blank"
              rel="noreferrer"
              class="publication"
              data-reveal
            >
              <div>
                <span>{publication.year}</span>
                <span>{publication.role}</span>
              </div>
              <h3>{publication.title}</h3>
              <p>{publication.venue}</p>
              <i>↗</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="notes section-shell" id="notes">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">05 / NOTES</span>
          <h2>最近在想什么</h2>
        </div>
        <p>记录理解发生的过程，而不只保存最后的答案。</p>
      </div>

      <div class="notes-grid">
        {
          posts.map((post, index) => (
            <a class="note-card" href={getPostPath(post)} data-reveal>
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <time>{formatDate(post.data.date)}</time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <span class="note-more">阅读全文 ↗</span>
            </a>
          ))
        }
      </div>
      <a class="all-notes" href="/blog/">查看全部文章 <span>→</span></a>
    </section>

    <section class="closing section-shell" id="contact">
      <p data-reveal>
        好奇心不会直接给出答案，<br />但它会不断打开新的入口。
      </p>
      <div data-reveal>
        <span>如果你也在思考 AI、地理、工具，或者某个还没有名字的问题——</span>
        <a href="mailto:yuchenglong01@foxmail.com"
          >yuchenglong01@foxmail.com ↗</a
        >
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div>
      <strong>喻承龙</strong>
      <span>Chenglong Yu</span>
    </div>
    <p>沿着好奇心，去理解，也去动手。</p>
    <div class="footer-links">
      <a href="https://github.com/zhanlutuzi" target="_blank" rel="noreferrer"
        >GitHub ↗</a
      >
      <a
        href="https://www.researchgate.net/profile/Chenglong-Yu-10"
        target="_blank"
        rel="noreferrer">ResearchGate ↗</a
      >
      <a href="/blog/">Blog ↗</a>
    </div>
  </footer>

  <dialog class="video-dialog">
    <form method="dialog">
      <div>
        <span class="video-dialog-label">PROJECT DEMO</span>
        <strong data-dialog-title>项目演示</strong>
      </div>
      <button aria-label="关闭视频">关闭 ×</button>
    </form>
    <video controls playsinline preload="metadata"></video>
  </dialog>

  <script>
    const canvas = document.querySelector<HTMLCanvasElement>(".contour-canvas");
    const context = canvas?.getContext("2d");
    let pointerX = 0.64;
    let pointerY = 0.42;
    let frame = 0;

    function resizeCanvas() {
      if (!canvas) return;
      const ratio = Math.min(devicePixelRatio, 2);
      canvas.width = canvas.clientWidth * ratio;
      canvas.height = canvas.clientHeight * ratio;
    }

    function drawContours() {
      if (!canvas || !context) return;
      const ratio = Math.min(devicePixelRatio, 2);
      const width = canvas.width / ratio;
      const height = canvas.height / ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const t = reduced ? 0 : frame * 0.004;
      const focusX = width * pointerX;
      const focusY = height * pointerY;

      for (let line = -5; line < 18; line += 1) {
        context.beginPath();
        for (let x = -40; x <= width + 40; x += 8) {
          const distance = Math.hypot(x - focusX, line * 52 - focusY);
          const wave =
            Math.sin(x * 0.007 + line * 0.8 + t) * 22 +
            Math.cos(x * 0.003 - line + t * 0.6) * 13 +
            Math.sin(distance * 0.014 - t) * 18;
          const y = line * 52 + wave + height * 0.08;
          if (x === -40) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.strokeStyle =
          line % 4 === 0 ? "rgba(19, 32, 24, .35)" : "rgba(19, 32, 24, .14)";
        context.lineWidth = line % 4 === 0 ? 1.2 : 0.8;
        context.stroke();
      }

      frame += 1;
      requestAnimationFrame(drawContours);
    }

    addEventListener("resize", resizeCanvas);
    addEventListener(
      "pointermove",
      (event) => {
        pointerX = event.clientX / innerWidth;
        pointerY = event.clientY / innerHeight;
      },
      { passive: true },
    );
    resizeCanvas();
    drawContours();

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty("--rx", `${-y * 3.5}deg`);
        card.style.setProperty("--ry", `${x * 5}deg`);
      });
      card.addEventListener("pointerleave", () => {
        card.style.setProperty("--rx", "0deg");
        card.style.setProperty("--ry", "0deg");
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>(".video-dialog");
    const player = dialog?.querySelector("video");
    const dialogTitle = dialog?.querySelector<HTMLElement>(
      "[data-dialog-title]",
    );

    document.querySelectorAll<HTMLButtonElement>("[data-video]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!dialog || !player) return;
        player.src = button.dataset.video || "";
        if (dialogTitle) {
          dialogTitle.textContent = button.dataset.videoTitle || "项目演示";
        }
        dialog.showModal();
      });
    });

    dialog?.addEventListener("close", () => {
      if (!player) return;
      player.pause();
      player.removeAttribute("src");
      player.load();
    });
  </script>
</BaseLayout>
