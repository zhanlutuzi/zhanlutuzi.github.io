---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPostPath } from "../lib/blog";
import * as portfolioZh from "../data/portfolio";
import * as portfolioEn from "../data/portfolio.en";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";
const {
  education,
  experiences,
  personalWorks,
  projects,
  publications,
} = isEnglish ? portfolioEn : portfolioZh;

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const englishPosts: Record<string, { title: string; summary: string }> = {
  "我让 5 个 AI 同时帮我写代码，然后发现了一个所有人都忽略的问题": {
    title:
      "I asked five AI agents to code in parallel—and found the problem everyone misses",
    summary:
      "After four failed attempts, I developed ADD: a document- and worktree-based method for coordinating multiple coding agents.",
  },
  "AlphaEvolve 正在变成一种科研方法论吗": {
    title: "Is AlphaEvolve becoming a research methodology?",
    summary:
      "A look at how AlphaEvolve is moving from algorithm optimization toward a reusable workflow for scientific discovery—and where its limits lie.",
  },
  "OpenClaw 与 Hermes Agent：AI 助理真正开始碰你的电脑之后": {
    title:
      "OpenClaw and Hermes Agent: when AI assistants begin touching your computer",
    summary:
      "From gateways and self-evolving runtimes to security incidents, a closer look at the promise and cost of personal AI assistants.",
  },
  "腾讯云深度研究报告：一家「被迫出战」的云计算巨头": {
    title: "Tencent Cloud: the cloud giant that was forced into battle",
    summary:
      "A long-form study of how internal infrastructure, industrial internet strategy, and AI shaped Tencent Cloud.",
  },
  "我是如何从一串问题，搭起大模型知识结构的": {
    title: "How I built a mental model of LLMs from a chain of questions",
    summary:
      "A connected map of Transformer lineages, internal data flow, MoE, multimodality, alignment, and the surrounding engineering stack.",
  },
};

const localizedPosts = posts.map((post) => ({
  post,
  title: isEnglish
    ? englishPosts[post.data.title]?.title || post.data.title
    : post.data.title,
  summary: isEnglish
    ? englishPosts[post.data.title]?.summary || post.data.summary
    : post.data.summary,
}));

const copy = isEnglish
  ? {
      title: "Chenglong Yu | Curiosity, understanding, and making",
      description:
        "A geospatial engineer and curious generalist working across AI, products, research, and tools for real people.",
      homeAria: "Back to the top",
      navAria: "Page navigation",
      nav: ["About", "Experience", "Projects", "Research", "Writing"],
      contact: "Contact",
      language: "中文",
      languageHref: "/",
      hero: ["Follow curiosity.", "Understand the world.", "Build what matters."],
      heroIntro:
        "I think of myself as a curious generalist. Geography is where I begin to observe the world; technology is how I understand and change problems; people are the measure I use to decide what is worth building.",
      viewWork: "See what I’ve built",
      viewExperience: "See my experience",
      globeAria:
        "An interactive journey connecting Wuhan, Tokyo, Hangzhou, and Beijing",
      globeHint: "Move to explore",
      globePlaces: "Wuhan · Tokyo · Hangzhou · Beijing",
      scroll: "Get to know me",
      aboutHeading: ["Between the human", "and the technical."],
      about1:
        "I studied Geospatial Information Engineering in both my bachelor’s and master’s programs. Geography taught me to pay attention to people, cities, space, and relationships; programming lets me turn judgment into tools, systems, and testable prototypes.",
      about2:
        "From WebGIS and spatial analysis to NL2SQL and Agents, I conduct research, write code, run services, and shape products. I do not want technology detached from real people, nor do I want to stop at discussing ideas.",
      aboutStrong:
        "Curiosity opens the question, a human perspective sets the direction, and technical ability lets me make the idea real.",
      experienceHeading: "Paths I’ve taken",
      experienceIntro:
        "Across these three experiences, I conducted research, wrote code, and worked with real users to move products forward.",
      educationHeading: "Education",
      projectsHeading: "Things I’ve built",
      projectsIntro:
        "Each project began with a geographic problem: understand the data, call the right tools, and bring the result into a real workflow.",
      watchDemo: "Watch demo",
      builtHeading: ["Built because", "I needed them"],
      builtIntro:
        "Tools, methods, and infrastructure I maintain outside my primary work.",
      researchHeading: ["Research is another way", "to understand the world."],
      researchIntro:
        "My work extends from human–database interaction for geospatial data to multimodal land-use classification, geographic representation learning, and global risk analysis.",
      notesHeading: "What I’ve been thinking about",
      notesIntro:
        "Writing in Chinese: documenting how understanding develops, not only preserving the final answer.",
      readMore: "Read in Chinese",
      allNotes: "View all writing",
      closing: [
        "Curiosity does not hand us answers.",
        "It keeps opening new doors.",
      ],
      contactIntro:
        "If you are also thinking about AI, geography, tools, or a problem that does not have a name yet—",
      footerLine: "Follow curiosity. Understand the world. Build what matters.",
      demoLabel: "PROJECT DEMO",
      demoTitle: "Project demo",
      close: "Close",
      closeVideo: "Close video",
      previewAlt: "demo preview",
    }
  : {
      title: "喻承龙｜沿着好奇心，去理解，也去动手",
      description:
        "热爱地理，也对技术、人和世界如何运作保持兴趣。记录项目、研究、工具与持续生长的想法。",
      homeAria: "回到首页",
      navAria: "页内导航",
      nav: ["关于", "经历", "项目", "研究", "写作"],
      contact: "联系我",
      language: "EN",
      languageHref: "/en/",
      hero: ["沿着好奇心，", "去理解，", "也去动手。"],
      heroIntro:
        "我把自己叫作“杂学家”。地理是观察世界的起点，技术是理解并改变问题的工具，而人始终是我判断一件事是否值得做的尺度。",
      viewWork: "看我做过什么",
      viewExperience: "看我的经历",
      globeAria: "武汉、东京、杭州与北京组成的个人经历路径",
      globeHint: "移动鼠标探索地点",
      globePlaces: "武汉 · 东京 · 杭州 · 北京",
      scroll: "向下认识我",
      aboutHeading: ["站在人文与", "技术之间。"],
      about1:
        "我本科和硕士都学习地理空间信息工程。地理让我关注人、城市、空间与关系；编程让我能把判断做成工具、系统和可以验证的原型。",
      about2:
        "从 WebGIS、空间分析到 NL2SQL 与 Agent，我既做研究，也写代码、搭服务、做产品。我不想做远离真实人的技术，也不满足于只讨论概念。",
      aboutStrong:
        "好奇心打开问题，人文视角决定方向，技术能力让我把想法真正做出来。",
      experienceHeading: "走过的路",
      experienceIntro:
        "这三段经历里，我做研究、写代码，也和真实用户一起把产品往前推。",
      educationHeading: "教育经历",
      projectsHeading: "做过的东西",
      projectsIntro:
        "三个项目都从地理问题出发：先理解数据，再调用工具，最后走进真实的工作入口。",
      watchDemo: "观看演示",
      builtHeading: ["因为自己需要，", "所以动手做了"],
      builtIntro: "一些工作之外的工具、方法和长期维护。",
      researchHeading: ["研究，是另一种", "理解世界的方式。"],
      researchIntro:
        "我的研究从地理数据库的人机交互，延伸到多模态土地利用识别、地理表征学习与全球风险分析。",
      notesHeading: "最近在想什么",
      notesIntro: "记录理解发生的过程，而不只保存最后的答案。",
      readMore: "阅读全文",
      allNotes: "查看全部文章",
      closing: ["好奇心不会直接给出答案，", "但它会不断打开新的入口。"],
      contactIntro:
        "如果你也在思考 AI、地理、工具，或者某个还没有名字的问题——",
      footerLine: "沿着好奇心，去理解，也去动手。",
      demoLabel: "PROJECT DEMO",
      demoTitle: "项目演示",
      close: "关闭",
      closeVideo: "关闭视频",
      previewAlt: "演示画面",
    };
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  image={isEnglish ? "/og-en.png" : "/og.png"}
  lang={isEnglish ? "en" : "zh-CN"}
  alternateHref={copy.languageHref}
>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label={copy.homeAria}>
      <span>{isEnglish ? "CHENGLONG YU" : "喻承龙"}</span>
      <small>{isEnglish ? "喻承龙" : "CHENGLONG YU"}</small>
    </a>
    <nav aria-label={copy.navAria}>
      <a href="#about">{copy.nav[0]}</a>
      <a href="#experience">{copy.nav[1]}</a>
      <a href="#projects">{copy.nav[2]}</a>
      <a href="#research">{copy.nav[3]}</a>
      <a href="#notes">{copy.nav[4]}</a>
    </nav>
    <div class="header-actions">
      <a
        href="https://www.linkedin.com/in/chenglong-yu-432306243"
        target="_blank"
        rel="noreferrer">LinkedIn ↗</a
      >
      <a
        class="language-switch"
        href={copy.languageHref}
        lang={isEnglish ? "zh-CN" : "en"}
        >{copy.language}</a
      >
      <a class="header-link" href="mailto:yuchenglong01@foxmail.com"
        >{copy.contact} ↗</a
      >
    </div>
  </header>

  <main id="top" class:list={[isEnglish && "lang-en"]}>
    <section class="hero">
      <canvas class="contour-canvas" aria-hidden="true"></canvas>
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>
          GEOGRAPHY · TECHNOLOGY · PEOPLE
        </p>
        <h1 data-reveal>
          {copy.hero[0]}<br />
          <em>
            {
              isEnglish ? (
                <>
                  Understand the <span class="hero-mark">world</span>.
                </>
              ) : (
                <>
                  去<span class="hero-mark">理解</span>，
                </>
              )
            }
          </em><br />
          {copy.hero[2]}
        </h1>
        <p class="hero-intro" data-reveal>{copy.heroIntro}</p>
        <div class="hero-actions" data-reveal>
          <a class="button button-dark" href="#projects">{copy.viewWork}</a>
          <a class="button button-ghost" href="#experience"
            >{copy.viewExperience}</a
          >
        </div>
      </div>

      <div class="hero-globe" data-locale={locale}>
        <canvas
          class="journey-globe"
          role="img"
          aria-label={copy.globeAria}
        ></canvas>
        <div class="globe-tooltip" aria-live="polite" hidden>
          <span data-globe-city></span>
          <strong data-globe-title></strong>
          <p data-globe-detail></p>
        </div>
        <div class="globe-caption">
          <span>{copy.globeHint}</span>
          <strong>{copy.globePlaces}</strong>
        </div>
      </div>

      <a class="scroll-cue" href="#about">
        <span>{copy.scroll}</span>
        <i></i>
      </a>
    </section>

    <section class="manifesto section-shell" id="about">
      <div class="section-index" data-reveal>00 / ABOUT</div>
      <div class="manifesto-grid">
        <h2 data-reveal>{copy.aboutHeading[0]}<br />{copy.aboutHeading[1]}</h2>
        <div class="manifesto-copy" data-reveal>
          <p>{copy.about1}</p>
          <p>
            {copy.about2} <strong>{copy.aboutStrong}</strong>
          </p>
        </div>
      </div>
    </section>

    <section class="experience section-shell" id="experience">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">01 / EXPERIENCE</span>
          <h2>{copy.experienceHeading}</h2>
        </div>
        <p>{copy.experienceIntro}</p>
      </div>

      <div class="timeline">
        {
          experiences.map((item) => (
            <article class="timeline-item" data-reveal>
              <div class="timeline-meta">
                <time>{item.period}</time>
                <strong class="timeline-place">{item.place}</strong>
              </div>
              <div class="timeline-main">
                <h3>{item.organization}</h3>
                <p class="department">{item.department}</p>
                <p class="role">{item.role}</p>
                <p class="timeline-summary">{item.summary}</p>
                <ul>
                  {item.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div class="education-heading" data-reveal>
        <span class="section-index">EDUCATION</span>
        <h3>{copy.educationHeading}</h3>
      </div>
      <div class="education-list">
        {
          education.map((item) => (
            <article class="education-item" data-reveal>
              <div class="education-meta">
                <strong>{item.degree}</strong>
                <time>{item.period}</time>
              </div>
              <div>
                <h4>{item.school}</h4>
                <p class="education-field">{item.field}</p>
                <p class="education-detail">{item.detail}</p>
                {
                  item.jointProgram && (
                    <div class="education-joint">
                      <a
                        href={item.jointProgram.institutionHref}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {item.jointProgram.institution} ↗
                      </a>
                      <a
                        href={item.jointProgram.advisorHref}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {item.jointProgram.advisor} ↗
                      </a>
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="projects section-shell" id="projects">
      <div class="section-heading light" data-reveal>
        <div>
          <span class="section-index">02 / SELECTED WORK</span>
          <h2>{copy.projectsHeading}</h2>
        </div>
        <p>{copy.projectsIntro}</p>
      </div>

      <div class="project-grid">
        {
          projects.map((project) => (
            <article
              class={`project-card tone-${project.tone}`}
              data-reveal
              data-tilt
            >
              <div class="project-topline">
                <span>{project.index}</span>
                <span>{project.eyebrow}</span>
              </div>
              {
                project.links.find((link) => link.kind === "video") && (
                  <button
                    class="project-preview"
                    type="button"
                    data-video={
                      project.links.find((link) => link.kind === "video")?.href
                    }
                    data-video-title={project.title}
                    aria-label={`${copy.watchDemo}: ${project.title}`}
                  >
                    <img
                      src={project.preview}
                      alt={`${project.title} ${copy.previewAlt}`}
                      loading="lazy"
                    />
                    <span class="preview-action">
                      <b>▶</b>
                      <span>{copy.watchDemo}</span>
                      <small>{project.duration}</small>
                    </span>
                  </button>
                )
              }
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <strong class="project-result">{project.result}</strong>
              <ul class="tag-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.links.some((link) => link.kind !== "video") && (
                <div class="project-links">
                  {project.links
                    .filter((link) => link.kind !== "video")
                    .map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label} ↗
                      </a>
                    ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="personal-work section-shell">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">03 / BUILT FOR MYSELF</span>
          <h2>{copy.builtHeading[0]}<br />{copy.builtHeading[1]}</h2>
        </div>
        <p>{copy.builtIntro}</p>
      </div>
      <div class="work-list">
        {
          personalWorks.map((work, index) => (
            <a
              class="work-row"
              href={work.href}
              target="_blank"
              rel="noreferrer"
              data-reveal
            >
              <span class="work-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <small>{work.meta}</small>
                <h3>{work.title}</h3>
              </div>
              <p>{work.description}</p>
              <span class="work-arrow">{work.label} ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="research section-shell" id="research">
      <div class="research-intro" data-reveal>
        <span class="section-index">04 / RESEARCH</span>
        <h2>{copy.researchHeading[0]}<br />{copy.researchHeading[1]}</h2>
        <p>{copy.researchIntro}</p>
        <a
          href="https://www.researchgate.net/profile/Chenglong-Yu-10"
          target="_blank"
          rel="noreferrer">ResearchGate ↗</a
        >
      </div>

      <div class="publication-list">
        {
          publications.map((publication) => (
            <a
              href={publication.href}
              target="_blank"
              rel="noreferrer"
              class="publication"
              data-reveal
            >
              <div>
                <span>{publication.year}</span>
                <span>{publication.role}</span>
              </div>
              <h3>{publication.title}</h3>
              <p>{publication.venue}</p>
              <i>↗</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="notes section-shell" id="notes">
      <div class="section-heading" data-reveal>
        <div>
          <span class="section-index">05 / NOTES</span>
          <h2>{copy.notesHeading}</h2>
        </div>
        <p>{copy.notesIntro}</p>
      </div>

      <div class="notes-grid">
        {
          localizedPosts.map(({ post, title, summary }, index) => (
            <a class="note-card" href={getPostPath(post)} data-reveal>
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <time>
                  {formatDate(post.data.date, isEnglish ? "en-GB" : "zh-CN")}
                </time>
              </div>
              <h3>{title}</h3>
              <p>{summary}</p>
              <span class="note-more">{copy.readMore} ↗</span>
            </a>
          ))
        }
      </div>
      <a class="all-notes" href="/blog/">{copy.allNotes} <span>→</span></a>
    </section>

    <section class="closing section-shell" id="contact">
      <p data-reveal>
        {copy.closing[0]}<br />{copy.closing[1]}
      </p>
      <div data-reveal>
        <span>{copy.contactIntro}</span>
        <div class="contact-links">
          <a href="mailto:yuchenglong01@foxmail.com"
            >yuchenglong01@foxmail.com ↗</a
          >
          <a
            href="https://www.linkedin.com/in/chenglong-yu-432306243"
            target="_blank"
            rel="noreferrer">LinkedIn ↗</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div>
      <strong>{isEnglish ? "Chenglong Yu" : "喻承龙"}</strong>
      <span>{isEnglish ? "喻承龙" : "Chenglong Yu"}</span>
    </div>
    <p>{copy.footerLine}</p>
    <div class="footer-links">
      <a href="https://github.com/zhanlutuzi" target="_blank" rel="noreferrer"
        >GitHub ↗</a
      >
      <a
        href="https://www.researchgate.net/profile/Chenglong-Yu-10"
        target="_blank"
        rel="noreferrer">ResearchGate ↗</a
      >
      <a
        href="https://www.linkedin.com/in/chenglong-yu-432306243"
        target="_blank"
        rel="noreferrer">LinkedIn ↗</a
      >
      <a href="/blog/">Blog ↗</a>
      <a href={copy.languageHref}>{copy.language} ↗</a>
    </div>
  </footer>

  <dialog class="video-dialog">
    <form method="dialog">
      <div>
        <span class="video-dialog-label">{copy.demoLabel}</span>
        <strong data-dialog-title>{copy.demoTitle}</strong>
      </div>
      <button aria-label={copy.closeVideo}>{copy.close} ×</button>
    </form>
    <video controls playsinline preload="metadata"></video>
  </dialog>

  <script>
    const canvas = document.querySelector<HTMLCanvasElement>(".contour-canvas");
    const context = canvas?.getContext("2d");
    let pointerX = 0.64;
    let pointerY = 0.42;
    let frame = 0;

    function resizeCanvas() {
      if (!canvas) return;
      const ratio = Math.min(devicePixelRatio, 2);
      canvas.width = canvas.clientWidth * ratio;
      canvas.height = canvas.clientHeight * ratio;
    }

    function drawContours() {
      if (!canvas || !context) return;
      const ratio = Math.min(devicePixelRatio, 2);
      const width = canvas.width / ratio;
      const height = canvas.height / ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const t = reduced ? 0 : frame * 0.004;
      const focusX = width * pointerX;
      const focusY = height * pointerY;

      for (let line = -5; line < 18; line += 1) {
        context.beginPath();
        for (let x = -40; x <= width + 40; x += 8) {
          const distance = Math.hypot(x - focusX, line * 52 - focusY);
          const wave =
            Math.sin(x * 0.007 + line * 0.8 + t) * 22 +
            Math.cos(x * 0.003 - line + t * 0.6) * 13 +
            Math.sin(distance * 0.014 - t) * 18;
          const y = line * 52 + wave + height * 0.08;
          if (x === -40) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.strokeStyle =
          line % 4 === 0 ? "rgba(19, 32, 24, .32)" : "rgba(19, 32, 24, .12)";
        context.lineWidth = line % 4 === 0 ? 1.2 : 0.8;
        context.stroke();
      }

      frame += 1;
      requestAnimationFrame(drawContours);
    }

    addEventListener("resize", resizeCanvas);
    addEventListener(
      "pointermove",
      (event) => {
        pointerX = event.clientX / innerWidth;
        pointerY = event.clientY / innerHeight;
      },
      { passive: true },
    );
    resizeCanvas();
    drawContours();

    const globeCanvas =
      document.querySelector<HTMLCanvasElement>(".journey-globe");
    const globeCard = document.querySelector<HTMLElement>(".hero-globe");
    const isEnglishGlobe = globeCard?.dataset.locale === "en";
    const globeContext = globeCanvas?.getContext("2d");
    const globeTooltip =
      document.querySelector<HTMLElement>(".globe-tooltip");
    const tooltipCity =
      globeTooltip?.querySelector<HTMLElement>("[data-globe-city]");
    const tooltipTitle =
      globeTooltip?.querySelector<HTMLElement>("[data-globe-title]");
    const tooltipDetail =
      globeTooltip?.querySelector<HTMLElement>("[data-globe-detail]");
    const journeyCities = [
      {
        name: isEnglishGlobe ? "Wuhan" : "武汉",
        lat: 30.59,
        lon: 114.3,
        title: isEnglishGlobe ? "Study & long-term building" : "学习与长期建设",
        detail: isEnglishGlobe
          ? "China University of Geosciences (Wuhan) · UrbanComp"
          : "中国地质大学（武汉） · UrbanComp",
        dx: isEnglishGlobe ? -55 : -45,
        dy: 23,
      },
      {
        name: isEnglishGlobe ? "Tokyo" : "东京",
        lat: 35.68,
        lon: 139.76,
        title: isEnglishGlobe ? "Research & product practice" : "研究与产品实践",
        detail: isEnglishGlobe
          ? "LocationMind · The University of Tokyo CSIS"
          : "LocationMind · 东京大学 CSIS",
        dx: 13,
        dy: -13,
      },
      {
        name: isEnglishGlobe ? "Hangzhou" : "杭州",
        lat: 30.27,
        lon: 120.15,
        title: isEnglishGlobe ? "AI education products" : "AI 教育产品",
        detail: isEnglishGlobe
          ? "Zhejiang Jingzhunxue Technology"
          : "浙江精准学科技有限公司",
        dx: 10,
        dy: 30,
      },
      {
        name: isEnglishGlobe ? "Beijing" : "北京",
        lat: 39.9,
        lon: 116.41,
        title: isEnglishGlobe ? "AI application R&D" : "AI 应用研发",
        detail: isEnglishGlobe
          ? "New Oriental · Internet Center"
          : "新东方教育科技集团 · 互联网中心",
        dx: isEnglishGlobe ? -54 : -44,
        dy: -14,
      },
    ];
    let globeFrame = 0;
    let globeTargetX = 0.5;
    let globeTargetY = 0.5;
    let globeViewX = 0.5;
    let globeViewY = 0.5;
    let hoveredCity = "";
    let projectedCities: {
      name: string;
      x: number;
      y: number;
      visible: boolean;
    }[] = [];
    let landRings: { lat: number; lon: number }[][] = [];

    function resizeGlobe() {
      if (!globeCanvas) return;
      const ratio = Math.min(devicePixelRatio, 2);
      globeCanvas.width = globeCanvas.clientWidth * ratio;
      globeCanvas.height = globeCanvas.clientHeight * ratio;
    }

    function projectGlobePoint(
      lat: number,
      lon: number,
      centerLon: number,
      tilt: number,
      centerX: number,
      centerY: number,
      radius: number,
    ) {
      const phi = (lat * Math.PI) / 180;
      const lambda = (lon * Math.PI) / 180 - centerLon;
      const x = Math.cos(phi) * Math.sin(lambda);
      const originalY = -Math.sin(phi);
      const originalZ = Math.cos(phi) * Math.cos(lambda);
      const y =
        originalY * Math.cos(tilt) - originalZ * Math.sin(tilt);
      const z =
        originalY * Math.sin(tilt) + originalZ * Math.cos(tilt);
      return {
        x: centerX + x * radius,
        y: centerY + y * radius,
        visible: z > 0.015,
      };
    }

    function drawProjectedLine(
      coordinates: { lat: number; lon: number }[],
      centerLon: number,
      tilt: number,
      centerX: number,
      centerY: number,
      radius: number,
    ) {
      if (!globeContext) return;
      let drawing = false;
      globeContext.beginPath();
      coordinates.forEach((coordinate) => {
        const point = projectGlobePoint(
          coordinate.lat,
          coordinate.lon,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
        if (!point.visible) {
          drawing = false;
          return;
        }
        if (!drawing) {
          globeContext.moveTo(point.x, point.y);
          drawing = true;
        } else {
          globeContext.lineTo(point.x, point.y);
        }
      });
      globeContext.stroke();
    }

    function decodeLand(topology: {
      transform: {
        scale: [number, number];
        translate: [number, number];
      };
      arcs: [number, number][][];
      objects: {
        land: {
          geometries: {
            type: string;
            arcs: number[][][];
          }[];
        };
      };
    }) {
      const decodedArcs = topology.arcs.map((arc) => {
        let x = 0;
        let y = 0;
        return arc.map(([deltaX, deltaY]) => {
          x += deltaX;
          y += deltaY;
          return {
            lon:
              x * topology.transform.scale[0] +
              topology.transform.translate[0],
            lat:
              y * topology.transform.scale[1] +
              topology.transform.translate[1],
          };
        });
      });

      const rings: { lat: number; lon: number }[][] = [];
      topology.objects.land.geometries.forEach((geometry) => {
        if (geometry.type !== "MultiPolygon") return;
        geometry.arcs.forEach((polygon) => {
          polygon.forEach((ring) => {
            const coordinates: { lat: number; lon: number }[] = [];
            ring.forEach((arcIndex, index) => {
              const reversed = arcIndex < 0;
              const source = decodedArcs[reversed ? ~arcIndex : arcIndex];
              const arc = reversed ? [...source].reverse() : source;
              coordinates.push(...(index === 0 ? arc : arc.slice(1)));
            });
            rings.push(coordinates);
          });
        });
      });
      return rings;
    }

    function updateGlobeTooltip() {
      if (!globeCanvas || !globeCard || !globeTooltip || !hoveredCity) return;
      const city = journeyCities.find((item) => item.name === hoveredCity);
      const point = projectedCities.find((item) => item.name === hoveredCity);
      if (!city || !point || !point.visible) {
        globeTooltip.hidden = true;
        return;
      }
      if (tooltipCity) tooltipCity.textContent = city.name;
      if (tooltipTitle) tooltipTitle.textContent = city.title;
      if (tooltipDetail) tooltipDetail.textContent = city.detail;
      globeTooltip.hidden = false;
      const left = Math.min(
        globeCard.clientWidth - globeTooltip.offsetWidth - 16,
        Math.max(16, globeCanvas.offsetLeft + point.x + 18),
      );
      const top = Math.min(
        globeCard.clientHeight - globeTooltip.offsetHeight - 52,
        Math.max(54, globeCanvas.offsetTop + point.y - 24),
      );
      globeTooltip.style.left = `${left}px`;
      globeTooltip.style.top = `${top}px`;
    }

    function drawGlobe() {
      if (!globeCanvas || !globeContext) return;
      const ratio = Math.min(devicePixelRatio, 2);
      const width = globeCanvas.width / ratio;
      const height = globeCanvas.height / ratio;
      const centerX = width / 2;
      const centerY = height / 2 - 8;
      const radius = Math.min(width, height) * 0.405;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      globeViewX += (globeTargetX - globeViewX) * 0.055;
      globeViewY += (globeTargetY - globeViewY) * 0.055;
      const centerLon =
        (124 * Math.PI) / 180 +
        (globeViewX - 0.5) * 0.32 +
        (reduced ? 0 : Math.sin(globeFrame * 0.0025) * 0.018);
      const tilt = -0.11 + (globeViewY - 0.5) * 0.18;

      globeContext.setTransform(ratio, 0, 0, ratio, 0, 0);
      globeContext.clearRect(0, 0, width, height);

      const fill = globeContext.createRadialGradient(
        centerX - radius * 0.28,
        centerY - radius * 0.35,
        radius * 0.08,
        centerX,
        centerY,
        radius,
      );
      fill.addColorStop(0, "rgba(251, 252, 253, 0.94)");
      fill.addColorStop(0.72, "rgba(204, 255, 77, 0.16)");
      fill.addColorStop(1, "rgba(55, 85, 255, 0.1)");
      globeContext.beginPath();
      globeContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
      globeContext.fillStyle = fill;
      globeContext.fill();
      globeContext.strokeStyle = "rgba(20, 32, 25, 0.62)";
      globeContext.lineWidth = 1.4;
      globeContext.stroke();

      globeContext.save();
      globeContext.beginPath();
      globeContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
      globeContext.clip();
      globeContext.strokeStyle = "rgba(20, 32, 25, 0.16)";
      globeContext.lineWidth = 0.8;

      for (let lat = -60; lat <= 60; lat += 20) {
        const coordinates = [];
        for (let lon = -180; lon <= 180; lon += 3) {
          coordinates.push({ lat, lon });
        }
        drawProjectedLine(
          coordinates,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      }

      for (let lon = -180; lon < 180; lon += 20) {
        const coordinates = [];
        for (let lat = -90; lat <= 90; lat += 3) {
          coordinates.push({ lat, lon });
        }
        drawProjectedLine(
          coordinates,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      }

      globeContext.strokeStyle = "rgba(20, 32, 25, 0.7)";
      globeContext.lineWidth = 1.05;
      landRings.forEach((ring) => {
        drawProjectedLine(
          ring,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      });

      globeContext.strokeStyle = "#3755ff";
      globeContext.lineWidth = 2.1;
      globeContext.setLineDash([4, 5]);
      for (let index = 0; index < journeyCities.length - 1; index += 1) {
        const start = journeyCities[index];
        const end = journeyCities[index + 1];
        const coordinates = [];
        for (let step = 0; step <= 28; step += 1) {
          const progress = step / 28;
          coordinates.push({
            lat:
              start.lat +
              (end.lat - start.lat) * progress +
              Math.sin(progress * Math.PI) * 2.5,
            lon: start.lon + (end.lon - start.lon) * progress,
          });
        }
        drawProjectedLine(
          coordinates,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
      }
      globeContext.setLineDash([]);
      globeContext.restore();

      projectedCities = [];
      journeyCities.forEach((city, index) => {
        const point = projectGlobePoint(
          city.lat,
          city.lon,
          centerLon,
          tilt,
          centerX,
          centerY,
          radius,
        );
        if (!point.visible) return;
        projectedCities.push({ name: city.name, ...point });
        const isHovered = hoveredCity === city.name;
        const pulse =
          reduced ? 0 : Math.sin(globeFrame * 0.045 + index * 1.4) * 1.2;
        globeContext.beginPath();
        globeContext.arc(
          point.x,
          point.y,
          (isHovered ? 12 : 8) + pulse,
          0,
          Math.PI * 2,
        );
        globeContext.fillStyle = isHovered
          ? "rgba(55, 85, 255, 0.22)"
          : "rgba(55, 85, 255, 0.12)";
        globeContext.fill();
        globeContext.beginPath();
        globeContext.arc(
          point.x,
          point.y,
          isHovered ? 5.2 : 4.2,
          0,
          Math.PI * 2,
        );
        globeContext.fillStyle = "#3755ff";
        globeContext.fill();
        globeContext.font =
          isEnglishGlobe
            ? '600 12px "Times New Roman", serif'
            : '600 13px "Songti SC", "STSong", "PingFang SC", serif';
        globeContext.fillStyle = "#142019";
        globeContext.fillText(
          city.name,
          point.x + city.dx,
          point.y + city.dy,
        );
      });

      updateGlobeTooltip();
      globeFrame += 1;
      requestAnimationFrame(drawGlobe);
    }

    addEventListener("resize", resizeGlobe);
    globeCanvas?.addEventListener(
      "pointermove",
      (event) => {
        const rect = globeCanvas.getBoundingClientRect();
        globeTargetX = Math.min(
          1,
          Math.max(0, (event.clientX - rect.left) / rect.width),
        );
        globeTargetY = Math.min(
          1,
          Math.max(0, (event.clientY - rect.top) / rect.height),
        );
        const pointerX = event.clientX - rect.left;
        const pointerY = event.clientY - rect.top;
        const nearest = projectedCities
          .filter((city) => city.visible)
          .map((city) => ({
            ...city,
            distance: Math.hypot(city.x - pointerX, city.y - pointerY),
          }))
          .sort((a, b) => a.distance - b.distance)[0];
        hoveredCity = nearest && nearest.distance < 24 ? nearest.name : "";
        globeCanvas.style.cursor = hoveredCity ? "pointer" : "grab";
        if (!hoveredCity && globeTooltip) globeTooltip.hidden = true;
      },
      { passive: true },
    );
    globeCanvas?.addEventListener("pointerleave", () => {
      globeTargetX = 0.5;
      globeTargetY = 0.5;
      hoveredCity = "";
      if (globeTooltip) globeTooltip.hidden = true;
      if (globeCanvas) globeCanvas.style.cursor = "grab";
    });
    fetch("/land-110m.json")
      .then((response) => response.json())
      .then((topology) => {
        landRings = decodeLand(topology);
      })
      .catch(() => {
        landRings = [];
      });
    resizeGlobe();
    drawGlobe();

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty("--rx", `${-y * 3.5}deg`);
        card.style.setProperty("--ry", `${x * 5}deg`);
      });
      card.addEventListener("pointerleave", () => {
        card.style.setProperty("--rx", "0deg");
        card.style.setProperty("--ry", "0deg");
      });
    });

    const dialog = document.querySelector<HTMLDialogElement>(".video-dialog");
    const player = dialog?.querySelector("video");
    const dialogTitle = dialog?.querySelector<HTMLElement>(
      "[data-dialog-title]",
    );

    document.querySelectorAll<HTMLButtonElement>("[data-video]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!dialog || !player) return;
        player.src = button.dataset.video || "";
        if (dialogTitle) {
          dialogTitle.textContent =
            button.dataset.videoTitle ||
            (document.documentElement.lang === "en"
              ? "Project demo"
              : "项目演示");
        }
        dialog.showModal();
      });
    });

    dialog?.addEventListener("close", () => {
      if (!player) return;
      player.pause();
      player.removeAttribute("src");
      player.load();
    });
  </script>
</BaseLayout>
